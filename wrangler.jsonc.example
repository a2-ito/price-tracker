/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "price-tracker",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-11",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		"binding": "IMAGES"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "price-tracker"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "price-tracker-db",
			"database_id": "<D1 データベースの ID>",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES_BUCKET",
			"bucket_name": "price-tracker-images"
		}
	],
	"vars": {
		"AUTH_TRUST_HOST": "true"
	},
	// 公開 URL はカスタムドメインのみ。プレビュー URL は Google の許可リダイレクト URI に
	// 含められずログインできないため無効にする
	"routes": [
		{
			"pattern": "<公開したいホスト名>",
			"custom_domain": true
		}
	],
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
	/**
	 * Secrets（wrangler secret put で登録。値はリポジトリに含めない）:
	 *   AUTH_SECRET         セッション署名鍵（openssl rand -base64 32）
	 *   AUTH_GOOGLE_ID      Google OAuth クライアント ID
	 *   AUTH_GOOGLE_SECRET  Google OAuth クライアントシークレット
	 *   ALLOWED_EMAILS      ログインを許可するメールアドレス（カンマ区切り）
	 */
}
